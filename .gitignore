# Dependency and runtime-state excludes
node_modules/

# Model policy (2026-09-19): the single current model file IS tracked at
# models/lari/current/swarm-model.json. On each release, overwrite that file
# with the newest model and commit (replacing the old). Everything else under
# models/ (checkpoints, backups, staging) stays out of git.
models/*
!models/lari/
models/lari/*
!models/lari/current/
models/lari/current/*
!models/lari/current/swarm-model.json

# Consolidation workspaces, staging areas, and timestamped model backups.
consolidation/
*.backup-*.json

# File-backed discourse-operator store (runtime state, recreated on demand).
learned_discourse_operators.json

*.log
.DS_Store

# Secrets (bot tokens, API keys) never belong in the repo.
.env
